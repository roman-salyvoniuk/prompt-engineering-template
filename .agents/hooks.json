{
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/hook_handler.py pre",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "post-tool-auditor": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/hook_handler.py post",
            "timeout": 25
          }
        ]
      }
    ]
  },
  "session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "uv run python scripts/hook_handler.py session_start",
        "timeout": 10
      }
    ]
  },
  "quality-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "uv run python scripts/hook_handler.py stop",
        "timeout": 45
      }
    ]
  }
}
